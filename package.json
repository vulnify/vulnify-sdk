{
  "name": "@vulnify/sdk",
  "version": "0.2.2",
  "description": "Vulnify SDK: ask Vulnify whether an AI agent action is allowed before running it.",
  "keywords": [
    "vulnify",
    "sdk",
    "authorization",
    "security",
    "ai-agents",
    "runtime-authorization"
  ],
  "homepage": "https://docs.vulnify.io",
  "bugs": {
    "url": "https://github.com/vulnify/vulnify-sdk/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vulnify/vulnify-sdk.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "test": "jest",
    "lint": "tsc --noEmit -p tsconfig.json",
    "check:package": "publint && attw --pack . && node scripts/verify-package.mjs",
    "generate:api": "openapi-typescript spec/openapi.json -o src/generated/openapi.ts",
    "check:api": "node scripts/check-openapi.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "openapi-typescript": "^7.13.0",
    "publint": "^0.3.15",
    "ts-jest": "^29.2.5",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0"
  }
}
