{
  "name": "@vulnify/sdk",
  "version": "0.1.1",
  "description": "Vulnify SDK: ask Vulnify whether an AI agent action is allowed before running it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vulnify/vulnify-sdk.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "jest",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0"
  }
}
